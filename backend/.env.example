# Copier ce fichier en `.env` et remplir les valeurs réelles.
# Le fichier `.env` est ignoré par git — ne jamais y committer de secret.

# === Sécurité ===
# Générer une clé forte : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# === OwnCloud : identifiants de compte (push/écriture) ===
OWNCLOUD_HOSTNAME=
OWNCLOUD_USERNAME=
OWNCLOUD_PASSWORD=

# === OwnCloud : lien de partage public (téléchargement du budget) ===
OWNCLOUD_SHARE_URL=
OWNCLOUD_SHARE_PASSWORD=
BUDGET_REMOTE_FILENAME=Budget 2026.xlsx
